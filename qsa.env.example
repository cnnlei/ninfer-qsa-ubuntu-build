# Copy to qsa.env via `bash qsa.sh init`. This private file is gitignored.
# Use your actual model paths (spaces are supported). Do not commit qsa.env.
QSA_GGUF="/path/to/Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf"
QSA_MMPROJ="/path/to/mmproj-Qwen3.8-27B-Q5_K-MIX.gguf"
QSA_OUTPUT_MODEL="$QSA_ROOT/models/Qwen3.8-27B-QSA-IQ3_S-mtp.ninfer"
QSA_MODEL="$QSA_OUTPUT_MODEL"

# Optional paths. Only small HF model metadata is downloaded automatically.
# QSA_BASE_MODEL_DIR="$QSA_ROOT/assets/base-model"
# QSA_DONOR_GGUF="/path/to/a/QSA-donor.gguf"  # normally unnecessary

QSA_MODEL_ID="qwen3.8-27b-qsa"
QSA_BIND="127.0.0.1"
QSA_PORT=18201
QSA_GPU=0
# For LAN use, set QSA_BIND="0.0.0.0" and set QSA_API_KEY_FILE to a local 0600 file.
# QSA_API_KEY_FILE="$QSA_ROOT/run/api.key"

# Initial tuning for RTX 5070 Ti 16 GB + a large RAM pool. Adjust after measuring.
# 262144=256K; 524288=512K; 1048576=1M (the latter two use YaRN).
QSA_CONTEXT=262144
QSA_TOP_BLOCKS=1024       # 1024 * 4 = 4096 historical tokens per decode query
QSA_KV_RESIDENT=8192      # VRAM positions; the remaining KV stays in RAM
QSA_KV_DTYPE="int8"
QSA_HOST_CACHE_MIB=16384   # separate host continuation cache budget
QSA_HEADROOM_MIB=725       # applies to all-resident/auto-capacity mode; streaming uses explicit context capacity
QSA_PREFILL_CHUNK=512
QSA_MAX_CONCURRENCY=1
QSA_MAX_OUTPUT=32768
QSA_EMBEDDING_RESIDENCY="host"
QSA_REASONING_EFFORT="xhigh"
QSA_SPARSE_PREFILL=0       # off = full dense prefill (upstream recommended)
QSA_GDN_FP16=0             # off = default FP32 GDN state
QSA_MTP=1
QSA_DRAFT_TOKENS=3
QSA_NGRAM_DRAFT_TOKENS=15
QSA_VISION=1
QSA_VISION_MAX_MERGED=512
QSA_PROPOSAL_HEAD=0        # pack optional indexed proposal head during conversion; saves VRAM when off
QSA_START_WAIT=60
QSA_STOP_WAIT=60

# Normally the newest matching release is selected. Pin one if desired.
# QSA_RELEASE_TAG="ubuntu24.04-sm120a-29c79545429f-r1.1"
# QSA_DOWNLOAD_DIR="$QSA_ROOT/downloads"
# QSA_RUNTIME_ROOT="$QSA_ROOT/runtime"
# QSA_PYTHON=python3.11    # optional: choose Python for the isolated conversion venv

